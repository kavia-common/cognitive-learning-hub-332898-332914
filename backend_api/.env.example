# Backend API environment variables (example)
# Do NOT commit real secrets; orchestrator will provide these in the container .env

# Database (provided by database_service wiring)
POSTGRES_URL=postgresql://<host>:<port>/<db>
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<db>
POSTGRES_PORT=<port>

# Auth
JWT_SECRET=<a-long-random-secret>
JWT_ISSUER=cognitive-learning-hub
JWT_AUDIENCE=cognitive-learning-hub-web
ACCESS_TOKEN_TTL_SECONDS=86400

# CORS
# In preview, set to the frontend container origin, e.g.:
# CORS_ALLOW_ORIGINS=https://vscode-internal-XXXXX-beta.beta01.cloud.kavia.ai:3000
CORS_ALLOW_ORIGINS=*
