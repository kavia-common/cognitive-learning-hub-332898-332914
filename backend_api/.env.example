# Backend API environment variables (example)
# Database (provided by database_service wiring)
POSTGRES_URL="postgresql://localhost:5000/myapp"
POSTGRES_USER="appuser"
POSTGRES_PASSWORD="dbuser123"
POSTGRES_DB="myapp"
POSTGRES_PORT="5000"

# Auth (MUST be set; use a strong random secret in production)
JWT_SECRET="change-me"
JWT_ISSUER="cognitive-learning-hub"
JWT_AUDIENCE="cognitive-learning-hub-web"
ACCESS_TOKEN_TTL_SECONDS="86400"

# CORS
CORS_ALLOW_ORIGINS="*"
